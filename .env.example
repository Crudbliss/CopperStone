PORT=3000
NODE_ENV=development
DB_PATH=./database.sqlite
SESSION_SECRET=your_secret_key_here
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

